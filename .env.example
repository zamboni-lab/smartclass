# Smartclass environment variables
# All configurable via SMARTCLASS_ prefix (see smartclass/config.py)
# Copy to .env and adjust as needed: cp .env.example .env

# Output directory for generated files
SMARTCLASS_OUTPUT_DIR=output

# Cache directory for downloaded/fetched data
SMARTCLASS_CACHE_DIR=.smartclass_cache

# SPARQL endpoint for Wikidata queries
SMARTCLASS_WIKIDATA_ENDPOINT=https://query.wikidata.org/sparql

# HTTP timeout in seconds
SMARTCLASS_HTTP_TIMEOUT=60

# Maximum number of HTTP retries
SMARTCLASS_HTTP_MAX_RETRIES=3

# Log level (DEBUG, INFO, WARNING, ERROR)
SMARTCLASS_LOG_LEVEL=INFO

# Additional endpoints available (not in env config):
# Qlever endpoint: https://qlever.dev/api/wikidata (for maintenance)
